{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/hizmet/layout,_N_T_/hizmet/[slug]/layout,_N_T_/hizmet/[slug]/page,_N_T_/hizmet/kalici-oje"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/hizmet/$d$slug/__PAGE__",
    "/hizmet/$d$slug",
    "/hizmet",
    "/_index",
    "/_head"
  ]
}